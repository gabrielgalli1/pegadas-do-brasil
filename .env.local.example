# Copie este arquivo para .env.local (que já é ignorado pelo git) e preencha
# com os valores do seu projeto Supabase: Settings → API Keys.
# A publishable key é feita para ser exposta no navegador — não é segredo.
# A service role pode ficar no .env.local ignorado pelo Git, mas nunca em NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Somente servidor. Nunca use NEXT_PUBLIC_ nestas variáveis e nunca envie ao Git.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Gere um segredo longo, guarde uma cópia segura e não o troque após publicar contas v1.
PIN_SECRET_V1=substitua_por_um_segredo_longo_e_aleatorio
